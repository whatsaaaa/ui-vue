{
  "name": "ui-vue-workspace",
  "private": true,
  "description": "Nuxt UI themed with the Whatsaaaa design system, for Vue and Nuxt",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:package && pnpm --filter \"playground-nuxt...\" --parallel dev",
    "dev:vue": "pnpm build:package && pnpm --filter \"playground-vue...\" --parallel dev",
    "build": "pnpm -r build",
    "build:package": "pnpm --filter @whatsaaaa/ui-vue build",
    "test": "run-s build:package test:unit",
    "test:unit": "vitest run",
    "test:browser": "run-s build test:browser:run",
    "test:browser:run": "playwright test",
    "test:browser:docker": "sh scripts/browser-tests-in-docker.sh",
    "test:browser:update": "sh scripts/browser-tests-in-docker.sh --update-snapshots=changed visual",
    "type-check": "run-s build:package type-check:root type-check:nuxt type-check:vue",
    "type-check:root": "tsc --noEmit -p tsconfig.json",
    "type-check:nuxt": "pnpm --filter playground-nuxt type-check",
    "type-check:vue": "pnpm --filter playground-vue type-check",
    "lint": "run-s lint:oxlint lint:eslint lint:css lint:package",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:css": "stylelint \"**/*.{css,vue}\" --fix",
    "lint:package": "pnpm -r lint:package",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "changeset": "changeset",
    "levels": "node scripts/levels-readme.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.14.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "1.65.1",
    "@tailwindcss/node": "4.3.5",
    "@tailwindcss/oxide": "4.3.5",
    "@types/node": "^24.19.2",
    "@whatsaaaa/design-system": "^1.0.0",
    "@whatsaaaa/eslint-config": "^1.0.0",
    "@whatsaaaa/format-config": "^1.0.0",
    "@whatsaaaa/oxlint-config": "^1.0.0",
    "@whatsaaaa/tsconfig": "^1.0.0",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "lightningcss": "^1.33.0",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "postcss-html": "^2.0.0",
    "publint": "^0.3.25",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "tailwind-variants": "^3.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@12.18.0"
}
